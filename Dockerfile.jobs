FROM mcr.microsoft.com/playwright/python:v1.55.0-noble
WORKDIR /app
COPY scraper/requirements.txt scraper/requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-cloud.txt
COPY scraper/metro ./scraper/metro
COPY scraper/wasi ./scraper/wasi
COPY scraper/fincaraiz ./scraper/fincaraiz
COPY scraper/job.py ./scraper/job.py
COPY catalogo ./catalogo
COPY oportunidades ./oportunidades
ENV PYTHONUNBUFFERED=1 RADAR_DATA_DIR=/data
RUN mkdir -p /data && chmod 700 /data
ENTRYPOINT ["python", "scraper/job.py"]
